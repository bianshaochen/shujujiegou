#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

// 定义链表结点结构体：存储数据内容、分类、后继指针
struct Node {
    char data[100];    // 存储F1信息字符串
    char type[20];     // 存储信息分类：车队/车手/赛事
    struct Node *next; // 指向下一个结点的指针
};

/*
函数功能：将传入的字符串全部转为小写，消除大小写差异，方便模糊匹配
参数：char *s：待转换的字符数组（字符串）
*/
void toLower(char *s)
{
    int i;
    // 循环遍历直到字符串结束符'\0'
    for (i = 0; s[i] != '\0'; i++)
    {
        s[i] = tolower(s[i]);
    }
}

/*
函数功能：遍历链表并打印链表所有内容，统一封装输出逻辑
参数：head：待打印链表头指针
*/
void printList(struct Node *head)
{
    struct Node *p = head;
    if (p == NULL)
    {
        printf("无数据\n");
        return;
    }
    while (p != NULL)
    {
        printf("[%s] %s\n", p->type, p->data);
        p = p->next;
    }
}

/*
函数功能：释放整条链表所有堆内存，防止内存泄漏
参数：head：需要释放的链表头指针
*/
void freeList(struct Node **head)
{
    struct Node *p = *head;
    struct Node *del;
    while (p != NULL)
    {
        del = p;
        p = p->next;
        free(del);
    }
    *head = NULL; // 头指针置空，避免野指针
}
/*
函数功能：遍历原始数据数组，根据关键词模糊查找，匹配项尾插生成结果链表
形参：
f1List[]：原始信息二维字符串数组
n：原始数据总组数
keyLow：已经转为小写的搜索关键词
hHead、hTail：一级结果链表的头、尾指针（二级指针修改实参）
*/
void searchByKey(char f1List[][100], int n, char *keyLow, struct Node **hHead, struct Node **hTail)
{
    int i;
    char temp[100]; // 临时存放单条信息，用于小写转换

    for (i = 0; i < n; i++)
    {
        // 取出数组内的信息内容
        strcpy(temp, f1List[i * 2]);
        // 内容全部小写
        toLower(temp);

        // strstr：在temp中查找子串keyLow，找到代表匹配成功
        if (strstr(temp, keyLow) != NULL)
        {
            // 动态开辟新结点内存
            struct Node *newNode = (struct Node *)malloc(sizeof(struct Node));
            strcpy(newNode->data, f1List[i * 2]);
            strcpy(newNode->type, f1List[i * 2 + 1]);
            newNode->next = NULL;

            // 尾插法：空链表则头尾都指向新结点
            if (*hHead == NULL)
            {
                *hHead = newNode;
                *hTail = newNode;
            }
            else
            {
                (*hTail)->next = newNode;
                *hTail = newNode;
            }
        }
    }
}
/*
函数功能：在F1搜索结果链表基础上，按指定类别筛选，新建筛选链表
srcHead：原搜索结果链表头
filterStr：需要筛选的分类名称
fHead、fTail：筛选后新链表头尾指针
*/
void filterByType(struct Node *srcHead, char *filterStr, struct Node **fHead, struct Node **fTail)
{
    struct Node *p = srcHead;
    while (p != NULL)
    {
        // strcmp：字符串完全相等返回0，匹配分类
        if (strcmp(p->type, filterStr) == 0)
        {
            // 新建筛选结点，复制原结点数据
            struct Node *fNode = (struct Node *)malloc(sizeof(struct Node));
            strcpy(fNode->data, p->data);
            strcpy(fNode->type, p->type);
            fNode->next = NULL;

            if (*fHead == NULL)
            {
                *fHead = fNode;
                *fTail = fNode;
            }
            else
            {
                (*fTail)->next = fNode;
                *fTail = fNode;
            }
        }
        p = p->next;
    }
}#define MAX_HIST 30    // 搜索历史最大存储条数
/*
F3实现原理：二维字符数组historyStr[条数][单条关键词长度]，数组+串操作存储历史
count：有效历史记录计数器，标记数组下标
*/
int main()
{
    // 原始F1数据源：成对存储【内容，分类】
    char f1List[][100] = {
        "F1 红牛车队",     "车队",
        "F1 法拉利车队",   "车队",
        "F1 梅赛德斯车队", "车队",
        "F1 赛车速度",     "赛事",
        "F1 维斯塔潘",     "车手",
        "F1 汉密尔顿",     "车手",
        "F1 勒克莱尔",     "车手",
        "F1 赛道记录",     "赛事"
    };
    int n = 8;          // 一共8组数据

    char historyStr[MAX_HIST][100]; // F3：二维数组存搜索关键词
    int count = 0;                  // 历史记录个数
    char key[100], keyLower[100];   // 原关键词、小写关键词
    char filterType[20];            // 筛选输入的分类

    // 两个链表：F1搜索结果链表、F2筛选结果链表
    struct Node *head = NULL, *tail = NULL;
    struct Node *filterHead = NULL, *filterTail = NULL;

    printf("========== F1信息检索系统 ==========\n");
    printf("支持模糊关键词搜索，忽略大小写\n");
    printf("请输入 F1 搜索关键词：");
    gets(key);

    // F3功能：本次搜索关键词存入历史二维数组（串拷贝strcpy）
    if (count < MAX_HIST)
    {
        strcpy(historyStr[count], key);
        count++;
    }

    // 关键词转小写，用于统一匹配
    strcpy(keyLower, key);
    toLower(keyLower);

    // 调用F1搜索函数，生成一级链表
    searchByKey(f1List, n, keyLower, &head, &tail);

    // 输出F1搜索结果
    printf("\n===== F1关键词搜索结果 =====\n");
    if (head == NULL)
    {
        printf("未找到相关 F1 信息\n");
    }
    else
    {
        printList(head);
    }

    // F2分类筛选
    printf("\n===== F2 按类型筛选 =====\n");
    printf("可选筛选类型：车队 / 车手 / 赛事\n");
    printf("请输入要筛选的类型：");
    gets(filterType);

    // 调用筛选函数生成新链表
    filterByType(head, filterType, &filterHead, &filterTail);

    // 打印筛选结果
    printf("\n===== F2筛选结果 =====\n");
    if (filterHead == NULL)
    {
        printf("该类型下无匹配数据\n");
    }
    else
    {
        printList(filterHead);
    }

    // F3：遍历二维数组，输出全部搜索历史记录
    printf("\n======== F3 搜索历史记录（数组+串实现）========\n");
    if (count == 0)
    {
        printf("暂无任何搜索记录\n");
    }
    else
    {
        for (int i = 0; i < count; i++)
        {
            printf("第%d次搜索关键词：%s\n", i + 1, historyStr[i]);
        }
    }

    // 程序结束，释放两块链表内存
    freeList(&head);
    freeList(&filterHead);
    printf("\n程序结束，已全部释放动态内存\n");

    return 0;
}

